# --- Required ---
# Secret key for encrypting provider credentials at rest and signing callbacks.
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me

# --- Database / queue (compose defaults) ---
DATABASE_URL=postgresql+asyncpg://sleeper:sleeper@postgres:5432/sleeper
REDIS_URL=redis://redis:6379/0

# --- Object storage (compose defaults) ---
MINIO_ENDPOINT=http://minio:9000
MINIO_ACCESS_KEY=sleeper
MINIO_SECRET_KEY=sleeper-minio-secret
MINIO_BUCKET=sleeper-files

# --- Provider API keys (set at least one before Phase 1) ---
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# GOOGLE_API_KEY=
# OPENROUTER_API_KEY=
