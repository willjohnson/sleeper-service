# --- Required ---
# Secret key for encrypting provider credentials at rest and signing callbacks.
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me

# Object store credentials, used both by the app and by the compose minio
# container. No defaults: tenants may point an s3 data store at any endpoint the
# worker can reach, including this one, so a well-known pair here would be a
# cross-tenant read of the payload bucket. Both must be set before the first
# `docker compose up`; changing them later needs `docker compose up -d --force-recreate minio`
# plus a matching update to any data store that stores them.
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(24))"
MINIO_ACCESS_KEY=change-me
MINIO_SECRET_KEY=change-me

# Redis authentication shared by the server, API, worker, and tests. Compose
# has no fallback and refuses to start without it. Use URL-safe characters
# because the value is embedded in REDIS_URL.
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
REDIS_PASSWORD=change-me

# The admin UI defaults to Secure cookies. Set false only for local HTTP use;
# leave unset behind HTTPS in any shared or production deployment.
# SESSION_HTTPS_ONLY=false
# SESSION_MAX_AGE_S=28800
# LOGIN_RATE_LIMIT=10
# LOGIN_RATE_WINDOW_S=300

# Number of reverse proxies in front of the app. The login rate limit is keyed
# on the client address, which behind a proxy means X-Forwarded-For — but that
# header is client-supplied, so it is only trusted when this says how many hops
# are real. 0 (the default) ignores it entirely, which is correct for direct
# exposure and when uvicorn --proxy-headers already rewrites the peer address.
# Setting it higher than the true hop count lets clients forge their address.
# TRUSTED_PROXY_HOPS=1

# OIDC issuer validation rejects loopback/private destinations. Set true only
# for local development/testing with a stub IdP on 127.0.0.1; leave unset in
# any shared or production deployment.
# OIDC_ALLOW_LOOPBACK_ISSUERS=true

# Total budget for one prompt-injection heuristic pass, shared across every
# pattern and every piece of untrusted content in it (tenants supply their own
# patterns, so the ceiling must not scale with how many they add). Exhausting
# it rejects the content. Raise it if jobs inline large text attachments.
# INJECTION_SCREEN_TIMEOUT_S=5.0

# Optional per-tenant setting: callback_allowlist restricts callback domains.
# Callback delivery always rejects non-public IP addresses even when allowlisted.

# Alert channels take Apprise URLs from team owners and the worker connects to
# them, so only vetted schemes are accepted and any host in one must be public.
# NOTIF_EXTRA_SCHEMES adds schemes to that set; anything added is host-validated
# regardless, so widening cannot skip the address check.
# NOTIF_EXTRA_SCHEMES=zulip,ryver
# Set this only where the alert server shares the worker's private network — it
# turns off the internal-reachability check for every channel.
# NOTIF_ALLOW_PRIVATE_HOSTS=true
# Optional per-tenant setting: notif_scheme_allowlist narrows the vetted set
# further for one tenant's teams. It can never widen it.

# --- Optional overrides ---
# Defaults point at localhost for local dev; docker compose sets its own
# in-network values for these, so you normally don't need them here.
# DATABASE_URL=postgresql+asyncpg://sleeper:sleeper@localhost:5432/sleeper
# When running outside Compose, use the same REDIS_PASSWORD in this URL:
# REDIS_URL=redis://:change-me@localhost:6379/0
# If 5432/6379 are already taken on your host, remap the compose port bindings
# (tests and local tools pick these up too):
# POSTGRES_HOST_PORT=5433
# REDIS_HOST_PORT=6380
# MINIO_ENDPOINT=http://localhost:9000
# MINIO_BUCKET=sleeper-files

# --- Provider API keys (set at least one before Phase 1) ---
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# GOOGLE_API_KEY=
# OPENROUTER_API_KEY=

# --- Langfuse tracing (optional; start with: docker compose --profile langfuse up -d) ---
# On first boot the profile creates its project/admin from these values — set
# them to random strings BEFORE first boot on any shared deployment (traces
# hold full prompts/responses; the compose fallbacks are public knowledge).
# LANGFUSE_HOST=http://localhost:3000
# LANGFUSE_PUBLIC_KEY=pk-lf-...
# LANGFUSE_SECRET_KEY=sk-lf-...
# LANGFUSE_INIT_USER_EMAIL=admin@example.com
# LANGFUSE_INIT_USER_PASSWORD=
# LANGFUSE_SALT=
# LANGFUSE_ENCRYPTION_KEY=   # 64 hex chars: python -c "import secrets; print(secrets.token_hex(32))"
